# GéoAxe — configuration du serveur (hébergement OVH)
# Le certificat SSL (HTTPS) doit être actif sur l'hébergement avant d'envoyer ce fichier.

# Redirige http:// et geoaxe.fr vers https://www.geoaxe.fr
RewriteEngine On
RewriteCond %{SERVER_PORT} 80 [OR]
RewriteCond %{HTTP_HOST} ^geoaxe\.fr$ [NC]
RewriteRule ^(.*)$ https://www.geoaxe.fr/$1 [R=301,L]

# Empêche l'affichage du contenu des dossiers
Options -Indexes
